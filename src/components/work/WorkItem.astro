---
import { Icon } from "astro-icon/components";

export interface Props {
    href: string;
    src: string;
}

const { href, src } = Astro.props;
---

<a class="relative rounded-2xl overflow-hidden group" href={href} target="_blank">
    <div class="absolute inset-0 w-full h-full bg-gray-300/20 duration-300 z-1 group-hover:opacity-0"></div>
    <img class="object-cover duration-300 group-hover:opacity-80 group-hover:scale-103 w-full aspect-video" alt={href} src={src} loading="lazy" />
    <div class="absolute flex flex-col justify-end bottom-0 left-0 p-4 w-full h-4/5 text-white bg-linear-to-t from-black/35 via-black/10 to-transparent pointer-events-none">
        <slot />
        <Icon name="fa6-solid:up-right-from-square" class="absolute bottom-4 right-4" />
    </div>
</a>
