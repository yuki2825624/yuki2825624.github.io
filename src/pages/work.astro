        <h1 class="text-center flex flex-col">
            <p class="text-5xl font-light tracking-[1rem]">PRODUCT</p>
            <span class="text-sm tracking-[1rem]">成果物</span>
        </h1>
        <div class="w-full lg:w-240 grid grid-cols-2 mx-auto gap-8">
            <WorkItem href="" src="/assets/work/licu.png">
                <h2 class="text-md">Discord Bot</h2>
                <p class="font-semibold text-lg">Licu</p>
            </WorkItem>
        </div>
    </div>
    <div class="mt-32 w-full flex flex-col gap-10">
        <h1 class="text-center flex flex-col">
            <p class="text-5xl font-light tracking-[1rem]">OSS</p>
            <span class="text-sm tracking-[1rem]">オープンソース</span>
